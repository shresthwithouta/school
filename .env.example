# Copy this file to .env.local and fill in real values.

# MongoDB connection string (Atlas standard/non-SRV string or local)
MONGODB_URI=""

# Auth.js secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Optional: on Vercel this is auto-detected; locally defaults to http://localhost:3000
# AUTH_URL="https://your-app.vercel.app"

# Email — Gmail SMTP (sends to any recipient, no domain needed).
# Enable 2-step verification on the Google account, then create an App Password.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# File/voice uploads — Cloudinary (Dashboard -> Account Details)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
