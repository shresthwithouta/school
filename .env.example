# Copy this file to .env.local and fill in real values.

# MongoDB connection string (local or Atlas)
MONGODB_URI="mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/school?retryWrites=true&w=majority"

# Auth.js secret — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Web Push — push notifications to PWA / installed app. Generate a key pair with:
#   node scripts/gen-vapid-keys.mjs
# The public key is shipped to the browser (NEXT_PUBLIC_*); keep the private key secret.
# Push is silently disabled when these are unset.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact URI sent to push services (must be a mailto: or https: URL).
VAPID_SUBJECT="mailto:admin@school.edu"
