{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/recurring",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/delayed-tasks",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 */2 * * *"
    }
  ]
}
